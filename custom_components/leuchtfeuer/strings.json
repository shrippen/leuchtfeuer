{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Leuchtfeuer",
        "description": "Connect a Harman Kardon Invoke running Leuchtfeuer. Create an API key on the speaker under System > Access (scope \"full\").",
        "data": {
          "host": "Host",
          "api_key": "API key"
        },
        "data_description": {
          "host": "Address of the speaker, e.g. invoke.lan or http://192.168.1.23 (https with a self-signed certificate works).",
          "api_key": "Key starting with lf_ (scope \"full\")."
        }
      },
      "zeroconf_confirm": {
        "title": "Leuchtfeuer found",
        "description": "Set up {name} at {host}? Enter an API key from System > Access on the speaker.",
