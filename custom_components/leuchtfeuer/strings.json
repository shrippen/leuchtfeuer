          "api_key": "API key"
        },
        "data_description": {
          "api_key": "Key starting with lf_ (scope \"full\")."
        }
      },
      "reauth_confirm": {
        "title": "New API key",
        "description": "The API key for {name} ({host}) was rejected. Enter a new one.",
        "data": {
          "api_key": "API key"
        },
        "data_description": {
          "api_key": "Key starting with lf_ (scope \"full\")."
        }
      }
    },
