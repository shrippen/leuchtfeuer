# Konfiguration von Leuchtfeuer (sh-Syntax). Der Installer legt sie als /data/leuchtfeuer/config ab;
# Änderungen danach auf dem Gerät: Datei bearbeiten und die Dienste neu starten (oder neu booten).

# Zielgerät (Hardware-Anpassung in src/leuchtfeuerd/target.go und device/); bisher nur "invoke"
TARGET="invoke"

# Name, unter dem sich das Gerät in Spotify, Tidal, UPnP, Cast, Sendspin und Bluetooth zeigt
DEVICE_NAME="HK Invoke"

# Sendspin (Music Assistant): Adresse "host:8927" des Servers. Leer = Suche per mDNS. Nötig, wenn mDNS
# zwischen WLAN und LAN nicht durch den Router kommt (häufig bei AVM/FRITZ!Box, WLAN <-> LAN).
SENDSPIN_SERVER=""

# DHCP-Hostname, unter dem der Router das Gerät einträgt (z. B. "invoke" -> invoke.lan)
DHCP_HOSTNAME="invoke"

# Bluetooth-Kopplung: "button" = der Lautsprecher ist nur nach einem kurzen Druck auf den Bluetooth-Knopf
# (2 Minuten lang) sichtbar und koppelbereit; schon gekoppelte Geräte verbinden sich immer von selbst.
# "always" = dauerhaft sichtbar und koppelbereit (jeder in Reichweite kann koppeln).
BLUETOOTH_PAIRING="button"

# Zeitzone für Wecker und Timer (das Gerät selbst läuft auf Pacific Time). IANA-Name, z. B. Europe/Berlin.
TIMEZONE="Europe/Berlin"

# Dienste ein- und ausschalten (auch in der Weboberfläche, Einstellungen > Dienste). Ausgeschaltete Dienste startet der
# Hook nicht, ihre Ports bleiben zu. Vorgabe: alle an außer Snapcast.
SERVICE_SPOTIFY="on"
SERVICE_UPNP="on"
SERVICE_CAST="on"
SERVICE_AIRPLAY="on"
SERVICE_SENDSPIN="on"
SERVICE_BLUETOOTH="on"
SERVICE_TIDAL="on"
SERVICE_SNAPCAST="off"

# Snapcast (Multiroom): Adresse des snapservers, "host" oder "host:1704". Nötig, sobald SERVICE_SNAPCAST="on".
SNAPCAST_SERVER=""

# Uhrzeit: NTP-Server, mit dem der Hook die Uhr stellt (Wecker brauchen die richtige Zeit)
NTP_SERVER="pool.ntp.org"

# Weboberfläche (Port 80, Anmeldeseite): Das Passwort steht hier nie im Klartext, sondern als gesalzener Hash
# (WEB_PASSWORD_HASH). Setzen mit install.sh oder scripts/set-web-password.sh, oder in der Oberfläche (Einstellungen).
# Port optional: WEB_PORT="80"
# HTTPS mit eigenem Zertifikat (der Browser warnt beim ersten Mal): WEB_TLS="on", Port WEB_TLS_PORT="443".
# Dann leitet HTTP auf HTTPS um.
WEB_TLS="off"

# Updates aus der Weboberfläche: öffentlicher Ed25519-Schlüssel (Base64) des Release-Signierers. Leer = Updates nur mit
# install.sh. Der Schlüssel der offiziellen Releases steht in docs/release-key.pub.
UPDATE_PUBKEY=""

# Hardware-Watchdog: startet das Gerät neu, wenn es hängt (nur, wenn /dev/watchdog vorhanden ist; erst nach dem
# Gerätetest einschalten, siehe scripts/smoke.sh). Nach 3 Neustarts ohne 30 Minuten stabile Laufzeit bleibt er aus.
WATCHDOG="off"
