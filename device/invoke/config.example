# Konfiguration von Leuchtfeuer (sh-Syntax). Der Installer legt sie als /data/invoke/config ab;
# Änderungen danach auf dem Gerät: Datei bearbeiten und die Dienste neu starten (oder neu booten).

# Name, unter dem sich das Gerät in Spotify, Tidal, UPnP, Cast, Sendspin und Bluetooth zeigt
DEVICE_NAME="HK Invoke"

# Sendspin (Music Assistant): Adresse "host:8927" des Servers. Leer = Suche per mDNS. Nötig, wenn mDNS
# zwischen WLAN und LAN nicht durch den Router kommt (häufig bei AVM/FRITZ!Box, WLAN <-> LAN).
SENDSPIN_SERVER=""

# DHCP-Hostname, unter dem der Router das Gerät einträgt (z. B. "invoke" -> invoke.lan)
DHCP_HOSTNAME="invoke"

# Bluetooth-Kopplung: "button" = der Lautsprecher ist nur nach einem kurzen Druck auf den Bluetooth-Knopf
# (2 Minuten lang) sichtbar und koppelbereit; schon gekoppelte Geräte verbinden sich immer von selbst.
# "always" = dauerhaft sichtbar und koppelbereit (jeder in Reichweite kann koppeln).
BLUETOOTH_PAIRING="button"

# Zeitzone für Wecker und Timer (das Gerät selbst läuft auf Pacific Time). IANA-Name, z. B. Europe/Berlin.
TIMEZONE="Europe/Berlin"

# AirPlay-Empfänger (iPhone, iPad, Mac): "on" oder "off"
AIRPLAY="on"

# Weboberfläche (Port 80, Anmeldeseite): Das Passwort steht hier nie im Klartext, sondern als gesalzener Hash
# (WEB_PASSWORD_HASH). Setzen mit install.sh oder scripts/set-web-password.sh, oder in der Oberfläche (Einstellungen).
# Port optional: WEB_PORT="80"
